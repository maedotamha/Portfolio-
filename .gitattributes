# Auto detect text files and perform LF normalization
* text=auto

# Explicitly set line endings for common file types
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf

# Binary files
*.ico  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.woff binary
*.woff2 binary
